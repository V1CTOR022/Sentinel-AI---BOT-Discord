# Discord
DISCORD_TOKEN=
DISCORD_GUILD_ID=

# Banco de dados
DATABASE_PATH=data/sentinel.db

# Moderação (opcional)
MOD_LOG_CHANNEL_ID=
FLOOD_LIMIT=6
FLOOD_WINDOW_SECONDS=8

# Relatórios automáticos (opcional)
REPORT_CHANNEL_ID=
REPORT_INTERVAL_HOURS=24

# IA (opcional) — sem AI_API_KEY e AI_MODEL, os comandos de IA ficam desativados.
# Funciona com qualquer API compatível com o formato OpenAI de chat completions.
#   OpenAI      AI_BASE_URL=https://api.openai.com/v1        AI_MODEL=gpt-4o-mini
#   Groq        AI_BASE_URL=https://api.groq.com/openai/v1   AI_MODEL=llama-3.3-70b-versatile
#   OpenRouter  AI_BASE_URL=https://openrouter.ai/api/v1     AI_MODEL=<fornecedor>/<modelo>
#   Ollama      AI_BASE_URL=http://localhost:11434/v1        AI_MODEL=llama3.1  (AI_API_KEY=ollama)
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1

# API
SENTINEL_API_KEY=
DASHBOARD_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
